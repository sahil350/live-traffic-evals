FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir "transformers==4.51.3" "huggingface_hub>=0.26,<1.0" "accelerate>=0.26"

COPY data_collection/topic_classify_weborganizer.py .

ENV HF_HOME=/app/.cache/huggingface
ENV OUTPUT_DIR=/app/outputs

CMD ["python", "topic_classify_weborganizer.py"]
